# Local-only NWUCHAS-CMIS configuration. Never commit real values.
DATABASE_URL="postgresql://nwuchas_app:change-me@localhost:5432/nwuchas_cmis?schema=public"
JWT_SECRET="replace-with-a-long-random-local-development-secret"

# Airtel Money UAT — copy values exactly as issued by Airtel; never commit them.
# Airtel callbacks stay disabled unless AIRTEL_MONEY_WEBHOOK_SECRET is configured.
AIRTEL_MONEY_API_URL="https://<airtel-uat-host-issued-to-nwuchas>"
AIRTEL_MONEY_CLIENT_ID="<airtel-uat-client-id>"
AIRTEL_MONEY_CLIENT_SECRET="<airtel-uat-client-secret>"
AIRTEL_MONEY_COUNTRY="ZM"
AIRTEL_MONEY_CURRENCY="ZMW"
AIRTEL_MONEY_WEBHOOK_SECRET="<shared-secret-only-if-confirmed-by-airtel>"
NEXT_PUBLIC_APP_URL="https://<public-uat-nwuchas-domain>"
